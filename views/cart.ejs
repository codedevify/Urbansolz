<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Cart | Urban Solz</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* === RESET & BASE === */
    *{margin:0;padding:0;box-sizing:border-box}
    body{
      font-family:'Poppins',sans-serif;
      background:linear-gradient(180deg,#f6f0e9 0%,#f5deb3 100%);
      color:#3e2723;
      min-height:100vh;
      display:flex;
      flex-direction:column;
    }

    /* === HEADER === */
    header{
      background:rgba(255,255,255,0.95);
      backdrop-filter:blur(10px);
      position:sticky;top:0;z-index:1000;
      display:flex;justify-content:space-between;align-items:center;
      padding:1rem 6%;
      box-shadow:0 4px 10px rgba(0,0,0,0.05);
    }
    header h1{
      font-size:1.5rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:1px;
      color:#3e2723;
    }
    header a{
      color:#4e342e;
      text-decoration:none;
      font-weight:500;
      transition:color .3s;
    }
    header a:hover{color:#a1887f}

    /* === MAIN CART SECTION === */
    main{
      flex:1;
      max-width:700px;
      margin:80px auto;
      padding:0 6%;
      text-align:center;
      animation:fadein 1s ease;
    }
    @keyframes fadein{from{opacity:0;transform:translateY(30px);}to{opacity:1;transform:translateY(0);}}

    main h1{
      font-size:2rem;
      font-weight:700;
      margin-bottom:25px;
      text-transform:uppercase;
      letter-spacing:1px;
    }

    /* === CART ITEMS === */
    .cart-items{
      background:#fff;
      border-radius:20px;
      box-shadow:0 10px 25px rgba(0,0,0,0.08);
      padding:30px;
      text-align:left;
      margin-bottom:30px;
    }
    .cart-item{
      display:flex;
      justify-content:space-between;
      align-items:center;
      border-bottom:1px solid #f0e0c0;
      padding:15px 0;
      font-size:1rem;
      gap:10px;
      flex-wrap:wrap;
    }
    .cart-item:last-child{border-bottom:none;}
    .cart-item strong{color:#3e2723;}

    /* Size badge */
    .size-badge{
      background:#3e2723;
      color:#fff;
      padding:4px 10px;
      border-radius:12px;
      font-size:0.8rem;
      margin-left:8px;
    }

    /* === REMOVE BUTTON === */
    .remove-btn{
      background:#d32f2f;
      color:#fff;
      border:none;
      padding:6px 12px;
      border-radius:12px;
      font-size:0.85rem;
      cursor:pointer;
      transition:background .3s;
    }
    .remove-btn:hover{background:#b71c1c;}

    /* === CLEAR ALL === */
    .clear-all{
      display:inline-block;
      background:#d32f2f;
      color:#fff;
      padding:10px 20px;
      border-radius:15px;
      font-size:0.9rem;
      text-decoration:none;
      margin-top:15px;
      transition:background .3s;
    }
    .clear-all:hover{background:#b71c1c;}

    /* === TOTALS BREAKDOWN === */
    .totals-breakdown{
      margin-top:20px;
      padding-top:15px;
      border-top:2px dashed #d1c4b8;
      font-size:1rem;
    }
    .totals-breakdown div{
      display:flex;
      justify-content:space-between;
      margin-bottom:8px;
    }
    .totals-breakdown .final-total{
      font-size:1.4rem;
      font-weight:700;
      color:#3e2723;
      padding-top:10px;
      border-top:2px solid #3e2723;
      margin-top:10px;
    }

    /* === EMAIL INPUT (shared) === */
    .email-wrapper {
      background:#fff;
      border-radius:20px;
      box-shadow:0 8px 25px rgba(0,0,0,0.08);
      padding:25px;
      margin-bottom:20px;
      text-align:center;
    }
    .email-wrapper input {
      width:100%;
      padding:14px 16px;
      border:1px solid #ccc;
      border-radius:12px;
      font-size:1.1rem;
    }
    .email-wrapper input:focus {
      border-color:#a1887f;
      box-shadow:0 0 8px rgba(161,136,127,0.4);
      outline:none;
    }

    /* === PAYMENT BUTTONS === */
    .payment-buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .payment-btn {
      flex: 1;
      min-width: 280px;
      padding: 16px;
      font-size: 1.1rem;
      font-weight: 600;
      border: none;
      border-radius: 25px;
      cursor: pointer;
      transition: all .3s;
      text-align: center;
    }
    .stripe-btn {
      background: #635bff;
      color: white;
    }
    .stripe-btn:hover { background: #4c46cc; transform: scale(1.03); }
    .paypal-btn {
      background: #ffc439;
      color: #1a1a1a;
    }
    .paypal-btn:hover { background: #ffcf5e; transform: scale(1.03); }

    #paypal-button-container {
      margin-top: 20px;
      min-height: 50px;
    }

    .empty{
      font-size:1.1rem;
      color:#4e342e;
      background:#fff;
      padding:30px;
      border-radius:20px;
      box-shadow:0 8px 25px rgba(0,0,0,0.08);
    }

    .back-link{
      display:inline-block;
      margin-top:30px;
      text-decoration:none;
      font-weight:500;
      color:#3e2723;
      transition:color .3s;
    }
    .back-link:hover{color:#a1887f}

    @media(max-width:600px){
      main{margin:60px auto;}
      main h1{font-size:1.7rem;}
      .cart-item{flex-direction:column;align-items:flex-start;}
      .totals-breakdown .final-total{font-size:1.25rem;}
      .payment-buttons { flex-direction: column; }
      .payment-btn { min-width: 100%; }
    }
  </style>
</head>
<body>

<header>
  <h1>Urban Solz</h1>
  <a href="/">Back to Shop</a>
</header>

<main>
  <h1>Your Cart</h1>

  <% if (cart.length === 0) { %>
    <div class="empty">
      <p>Your cart is empty</p>
    </div>
  <% } else { %>
    <div class="cart-items">
      <% cart.forEach((item, index) => { %>
        <div class="cart-item">
          <div style="flex:1;">
            <span><%= item.displayName || item.name %></span>
            <% if (item.size) { %>
              <span class="size-badge">Size <%= item.size %></span>
            <% } %>
            <span>× <%= item.quantity %></span>
          </div>

          <strong>£<%= (item.price * item.quantity).toFixed(2) %></strong>

          <form action="/remove-from-cart" method="POST" style="margin:0;">
            <input type="hidden" name="index" value="<%= index %>">
            <button type="submit" class="remove-btn">Remove</button>
          </form>
        </div>
      <% }) %>

      <div class="totals-breakdown">
        <div>
          <span>Subtotal</span>
          <span>£<%= total.toFixed(2) %></span>
        </div>
        <div>
          <span>Shipping (UK Standard)</span>
          <span>£3.99</span>
        </div>
        <div class="final-total">
          <span>Total to Pay</span>
          <span>£<%= (total + 3.99).toFixed(2) %></span>
        </div>
      </div>

      <div style="text-align:center; margin-top:20px;">
        <form action="/clear-cart" method="POST" style="display:inline;">
          <button type="submit" class="clear-all" style="width:50%">Clear All</button>
        </form>
      </div>
    </div>

    <!-- Shared Email Input -->
    <div class="email-wrapper">
      <input type="email" id="customerEmail" placeholder="Your Email Address" required>
    </div>

    <!-- Payment Buttons -->
    <div class="payment-buttons">
      <button type="button" class="payment-btn stripe-btn" id="stripeCheckoutBtn">
        Pay with Stripe – £<%= (total + 3.99).toFixed(2) %>
      </button>

      <% if (paypalClientId && paypalClientId.trim() !== '') { %>
        <button type="button" class="payment-btn paypal-btn" id="paypalCheckoutBtn">
          Pay with PayPal – £<%= (total + 3.99).toFixed(2) %>
        </button>
      <% } %>
    </div>

    <!-- PayPal Container (hidden until clicked) -->
    <div id="paypal-button-container"></div>

    <!-- Hidden form for Stripe (will be submitted via JS) -->
    <form action="/checkout" method="POST" id="hiddenStripeForm">
      <input type="hidden" name="email" id="hiddenEmailField">
    </form>
  <% } %>

  <a class="back-link" href="/">Continue Shopping</a>
</main>

<script>
  // Get email once
  const emailInput = document.getElementById('customerEmail');
  const stripeBtn = document.getElementById('stripeCheckoutBtn');
  const paypalBtn = document.getElementById('paypalCheckoutBtn');
  const hiddenForm = document.getElementById('hiddenStripeForm');
  const hiddenEmail = document.getElementById('hiddenEmailField');

  // Stripe Checkout
  if (stripeBtn) {
    stripeBtn.addEventListener('click', () => {
      const email = emailInput.value.trim();
      if (!email || !email.includes('@')) {
        alert('Please enter a valid email address');
        return;
      }
      hiddenEmail.value = email;
      hiddenForm.submit();
    });
  }

  // PayPal Checkout
  if (paypalBtn) {
    paypalBtn.addEventListener('click', () => {
      const email = emailInput.value.trim();
      if (!email || !email.includes('@')) {
        alert('Please enter a valid email address');
        return;
      }

      // Load PayPal SDK only when clicked
      if (typeof paypal !== 'undefined') {
        renderPayPalButtons(email);
      } else {
        const script = document.createElement('script');
        script.src = `https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=GBP`;
        script.src = 'https://www.paypal.com/sdk/js?client-id=' + encodeURIComponent('<%= paypalClientId %>') + '&currency=GBP&intent=capture';
        script.onload = () => renderPayPalButtons(email);
        document.head.appendChild(script);
      }
    });
  }

  function renderPayPalButtons(customerEmail) {
    if (typeof paypal === 'undefined') return;

    paypal.Buttons({
      createOrder: (data, actions) => {
        return fetch('/create-paypal-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: customerEmail })
        })
        .then(res => res.json())
        .then(order => order.id);
      },
      onApprove: (data) => {
        return fetch('/capture-paypal-order/' + data.orderID, {
          method: 'POST'
        })
        .then(res => res.json())
        .then(() => {
          window.location.href = '/success';
        });
      },
      onError: (err) => {
        console.error(err);
        alert('PayPal payment failed. Please try again.');
      }
    }).render('#paypal-button-container');
  }
</script>

</body>
</html>